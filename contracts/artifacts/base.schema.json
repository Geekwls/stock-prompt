{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Geekwls/stock-prompt/contracts/artifacts/base.schema.json",
  "title": "stock-prompt Artifact Base v1",
  "type": "object",
  "required": ["artifact_type", "schema_version", "snapshot_id", "trading_date", "as_of", "data_status", "coverage", "evidence_ids", "formula_version", "status"],
  "properties": {
    "artifact_type": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}$"},
    "trading_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "as_of": {"type": "string", "minLength": 10},
    "data_status": {"enum": ["ok", "partial", "unavailable"]},
    "coverage": {"type": "string", "pattern": "^(N/A|(?:100|[0-9]{1,2})(?:\\.[0-9]+)?%)$"},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "model_version": {"type": ["string", "null"]},
    "formula_version": {"type": "string", "minLength": 1},
    "status": {"enum": ["complete", "partial", "degraded", "failed", "emitted_only"]},
    "missing": {"type": "array", "items": {"type": "string"}},
    "conflicts": {"type": "array"},
    "created_at": {"type": "string"}
  },
  "additionalProperties": true
}
