    "sentiment_score": {"type": "number"}, "position": {"type": "string"}, "opportunity_score": {"type": "number"}, "top_sector": {"type": "string"},
    "evidence": {"type": "array"}, "indices_full": {"type": "array"}, "sectors_full": {"type": "array"},
    "watchlist_full": {"type": "array"}, "risk_warning": {"type": "string"}
  },
