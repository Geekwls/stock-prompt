{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Geekwls/stock-prompt/contracts/artifacts/daily-score.schema.json",
  "title": "Daily Score Artifact",
  "type": "object",
  "required": ["artifact_type", "schema_version", "snapshot_id", "trading_date", "as_of", "data_status", "coverage", "evidence_ids", "formula_version", "status", "metrics"],
  "properties": {
    "artifact_type": {"const": "daily_score"}, "schema_version": {"const": "1.0"},
    "snapshot_id": {"type": "string"}, "trading_date": {"type": "string"}, "as_of": {"type": "string"},
    "data_status": {"enum": ["ok", "partial", "unavailable"]}, "coverage": {"type": "string"},
    "evidence_ids": {"type": "array"}, "formula_version": {"type": "string"},
    "status": {"enum": ["complete", "partial", "degraded", "failed", "emitted_only"]},
    "metrics": {"type": "object"}, "top_sector": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
